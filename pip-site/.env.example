# ---- pip marketing site — serverless env (Vercel project "pip-site") ----
# These power the payment webhooks (api/webhooks/*) and the crypto checkout
# (api/checkout/moonpay.js). They are set in the Vercel "pip-site" project env
# (via `vercel env add <NAME> production`), NOT in the bot's root .env — the bot
# never reads these. Copy to `.env` only for local `vercel dev`.

# Supabase — the webhooks upsert paid access into beta_testers with the secret
# key (bypasses RLS). Fill ONE of the two; SECRET_KEY is preferred.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=            # sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=     # legacy JWT eyJ... (alternative to the above)

# Dodo Payments (card / merchant-of-record) — webhook signing secret (Standard
# Webhooks). From the Dodo dashboard → Webhooks.
DODO_WEBHOOK_SECRET=           # whsec_...

# Loop Crypto (legacy USDC path — superseded by MoonPay, webhook kept for now).
LOOP_WEBHOOK_SECRET=

# MoonPay Commerce (Helio) — the live crypto/USDC checkout.
#  - WEBHOOK_TOKEN / WEBHOOK_SECRET: the per-webhook secret from webhook creation
#    (either scheme is accepted; set both to the same value is fine).
#  - PUBLIC_KEY / SECRET_KEY: the account API keys (Dashboard → Settings → API),
#    used by api/checkout/moonpay.js to create charges.
MOONPAY_WEBHOOK_TOKEN=
MOONPAY_WEBHOOK_SECRET=
MOONPAY_PUBLIC_KEY=
MOONPAY_SECRET_KEY=
