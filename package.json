{
  "name": "pip-bot",
  "version": "0.1.0",
  "private": true,
  "description": "AI research analyst for crypto / finance / trading communities — grounded answers + per-guild memory.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "register-commands": "tsx src/scripts/register-commands.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "welcome-member": "tsx src/scripts/welcome-member.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^22.5.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "grammy": "^1.44.0",
    "p-retry": "^6.2.0",
    "pdfjs-dist": "^6.1.200",
    "typescript": "^5.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "overrides": {
    "undici": "^6.27.0"
  }
}
