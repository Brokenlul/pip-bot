# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: set to register slash commands to a single guild for fast iteration.
DISCORD_DEV_GUILD_ID=

# Supabase — fill ONE of the two key slots (both bypass RLS).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=         # modern: sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=   # legacy JWT: eyJ...

# Data sources (CoinGecko free tier works without a key; demo keys recommended)
COINGECKO_API_KEY=
# FRED (St. Louis Fed macro data) — free key: https://fredaccount.stlouisfed.org/apikeys
# Optional: the macro_indicator tool (CPI/PCE/unemployment/GDP/yields) only loads if set.
# DexScreener, Polymarket, Kalshi, and RugCheck (token_scan security) need no key.
FRED_API_KEY=
# Solana Tracker (https://www.solanatracker.io/data-api) — free tier, no card.
# Optional: enriches token_scan with per-token top-traders-by-PnL (smart-money
# proxy). Without it, token_scan still returns market + RugCheck security data.
SOLANA_TRACKER_API_KEY=
# Finnhub (https://finnhub.io/register) — free tier, no card.
# Optional: powers the equity tools (equity_snapshot / equity_fundamentals /
# equity_earnings / financial_news). Registered only when set. Free tier covers
# US equities: quotes, key metrics, earnings surprises + calendar, news.
FINNHUB_API_KEY=
# Financial Modeling Prep (https://site.financialmodelingprep.com/developer/docs)
# — free tier. Optional: equity_financial_statements (full income/balance/
# cash-flow line items). DefiLlama, SEC EDGAR, and Fear & Greed need no key.
FMP_API_KEY=

# AI Wealth Manager companion API (read-only market understanding). Contract in
# PAUL_API.md. The market_intel tool + ambient backdrop load only when the key
# is set. Base URL defaults to the prod deployment; override only if needed.
PAUL_API_KEY=            # the paul_... key issued by the wealth manager
# PAUL_API_BASE_URL=https://ai-wealth-manager-nu.vercel.app

# Models — leave defaults unless you have a reason
ANSWER_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=voyage-3-lite
# Voyage = Anthropic's embedding partner. Optional — only needed for the
# semantic cache (M4). Memory persistence + recall (M5) work without it.
VOYAGE_API_KEY=

# Cache tuning
SEMANTIC_CACHE_SIMILARITY=0.92
SEMANTIC_CACHE_TTL_SECONDS=600
