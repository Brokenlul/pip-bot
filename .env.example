# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: set to register slash commands to a single guild for fast iteration.
DISCORD_DEV_GUILD_ID=

# Supabase — fill ONE of the two key slots (both bypass RLS).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=         # modern: sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=   # legacy JWT: eyJ...

# Data sources (CoinGecko free tier works without a key; demo keys recommended)
COINGECKO_API_KEY=

# Models — leave defaults unless you have a reason
ANSWER_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=voyage-3-lite
# Voyage = Anthropic's embedding partner. Optional — only needed for the
# semantic cache (M4). Memory persistence + recall (M5) work without it.
VOYAGE_API_KEY=

# Cache tuning
SEMANTIC_CACHE_SIMILARITY=0.92
SEMANTIC_CACHE_TTL_SECONDS=600
